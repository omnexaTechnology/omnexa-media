# Absolute site origin (no path, no trailing slash) used for canonical/hreflang URLs, Open Graph, sitemap.xml and robots.txt.
# Required for production builds: it is inlined at build time, so set it in the host's Production build env and rebuild.
NEXT_PUBLIC_SITE_URL=https://media.omnexa.sa

# GA4 Measurement ID (G-…, not the property number). Optional: when unset, no Google tag is loaded.
NEXT_PUBLIC_GA_ID=G-HCVNPRQZJC
